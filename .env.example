# ==========================================
# Team Work Status Dashboard - Environment Config
# ==========================================

# Server Port (Default: 3847)
PORT=3847

# OPTION 1: Cloud Database Connection String (Recommended for Vercel / Neon / Supabase / Render)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/teamdashboard?sslmode=require

# OPTION 2: Individual Local PostgreSQL Parameters (Used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=teamdashboard
PGUSER=postgres
PGPASSWORD=your_local_password
